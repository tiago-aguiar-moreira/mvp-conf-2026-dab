# Copie para .env e preencha. O .env não vai para o git.

# Senha do SA do SQL Server (>= 8 chars, com maiúscula, minúscula, dígito e símbolo)
MSSQL_SA_PASSWORD=DabDemo#2026

# Connection string lida pelo DAB via @env('DAB_DEMO_CONNECTION_STRING') no dab-config.json
DAB_DEMO_CONNECTION_STRING=Server=localhost,1433;Database=DabDemoEcommerce;User Id=sa;Password=DabDemo#2026;TrustServerCertificate=True;
